  "cards": [
    {
      "dot": "cyan",
      "title": "Zero-Token Supervision",
      "items": [
        "Bash watcher (bin/fm-watch.sh) monitors fleet panes without LLM polling",
        "Wakes First Mate only on status changes, prompt blocks, or wedge events",
        "Idle and running states are completely tokenless"
      ]
    },
    {
      "dot": "rose",
      "title": "Strict Isolation & Safety",
      "items": [
        "First Mate is strictly read-only over target project code (Hard Rule #1)",
        "Crewmates make changes inside clean, disposable Git worktrees",
        "PR merges require explicit Captain word unless in +yolo mode"
      ]
    },
    {
      "dot": "emerald",
      "title": "Fleet Orchestration",
      "items": [
        "Ship tasks deliver verified code via no-mistakes or direct-PR",
        "Scout tasks produce standalone reports in data/<id>/report.md",
        "Persistent Secondmates scale autonomous operations locally or over SSH"
      ]
    }
  ]
}
